@model Webproject.Models.ProductIndexViewModel

@{
    ViewData["Title"] = "Glamora";
}

<style>
    body {
        background-color: #fffafb;
        font-family: sans-serif;
    }

    .shop-logo {
        font-family: "Nosifer", sans-serif;
        color: #b83b5e;
        font-size: 40px;
        text-transform: uppercase;
        margin: 0;
    }

    .shop-controls {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin: 20px 0;
    }

    .search-input {
        border: 1px solid #f7d6e0;
        border-radius: 20px;
        padding: 7px 15px;
        min-width: 220px;
        outline: none;
    }

    .search-btn {
        background-color: #b83b5e;
        color: white;
        border: none;
        border-radius: 20px;
        padding: 7px 20px;
        cursor: pointer;
    }

    .btn-confirm-order {
        background-color: #b83b5e;
        color: white;
        border: none;
        padding: 10px 30px;
        border-radius: 25px;
        font-weight: bold;
        cursor: pointer;
    }

    .brand-divider {
        border-top: 2px solid #f9d5e5;
        margin: 40px 0 25px;
        text-align: center;
        position: relative;
    }

    .brand-title {
        background: #fffafb;
        padding: 0 15px;
        position: relative;
        top: -12px;
        color: #b83b5e;
        font-weight: bold;
    }

    .products-grid {
        display: grid;
        grid-template-columns: repeat(6, minmax(0, 1fr));
        gap: 20px;
    }

    .product-card {
        display: flex;
        flex-direction: column;
        border: 1px solid #f7d6e0;
        border-radius: 12px;
        padding: 15px;
        background: white;
        text-align: center;
        transition: transform 0.2s, box-shadow 0.2s;
        height: 100%;
        min-width: 0;
    }

    .card-content {
        display: flex;
        flex-direction: column;
        height: 100%;
    }

    .product-card:hover {
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
    }

    .product-img {
        width: 100%;
        height: 130px;
        object-fit: contain;
        display: block;
        margin-bottom: 10px;
    }

    .buy-btn {
        background: #b83b5e;
        color: white;
        border: none;
        border-radius: 20px;
        width: 100%;
        padding: 8px;
        cursor: pointer;
        transition: 0.2s;
    }

    .buy-btn:hover {
        background: #a52f50;
        transform: translateY(-1px);
    }

    .card-content form {
        margin-top: auto;
    }

    .product-description {
        font-size: 10px;
        color: #6c757d;
        margin: 3px 0;
        max-height: 0;
        opacity: 0;
        overflow: hidden;
        transition: 0.3s;
    }

    .product-card:hover .product-description {
        overflow: visible;
        max-height: 60px;
        opacity: 1;
    }

    .cart-row {
        text-align: right;
    }

    /* Large tablets / small desktops */
    @media (max-width: 1199px) {
        .products-grid {
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 18px;
        }
    }

    /* iPad / tablets */
    @media (max-width: 991px) {
        .products-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 16px;
        }

        .product-card {
            padding: 12px;
        }

        .product-img {
            height: 135px;
        }

        .shop-logo {
            font-size: 34px;
        }
    }

    /* Mobile */
    @media (max-width: 767px) {
        .shop-logo {
            font-size: 28px;
            line-height: 1.2;
        }

        .shop-controls {
            flex-direction: column;
            align-items: stretch;
            gap: 12px;
            margin: 15px 0;
        }

        .shop-controls h2 {
            text-align: center;
            margin: 0;
        }

        .shop-controls form {
            display: flex;
            width: 100%;
            gap: 8px;
        }

        .search-input {
            flex: 1;
            width: 100%;
            min-width: 0;
        }

        .search-btn {
            flex-shrink: 0;
            padding: 7px 16px;
        }

        .products-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 12px;
        }

        .product-card {
            padding: 10px;
            border-radius: 10px;
        }

        .product-img {
            height: 120px;
            margin-bottom: 6px;
        }

        .product-card h6 {
            font-size: 12px;
            line-height: 1.35;
            min-height: 32px;
            margin: 8px 0 !important;
        }

        .product-card p {
            font-size: 12px;
        }

        .product-description {
            max-height: none;
            opacity: 1;
            overflow: visible;
            font-size: 10px;
            line-height: 1.35;
            margin-bottom: 8px;
        }

        .buy-btn {
            font-size: 12px;
            padding: 8px 6px;
        }

        .btn-confirm-order {
            padding: 9px 18px;
            font-size: 13px;
        }

        .cart-row {
            text-align: center !important;
        }

        .cart-row .btn-confirm-order {
            width: 100%;
            max-width: 320px;
        }

        .brand-divider {
            margin: 30px 0 18px;
        }
    }

    /* Very small phones */
    @media (max-width: 359px) {
        .products-grid {
            grid-template-columns: 1fr;
        }

        .shop-logo {
            font-size: 24px;
        }

        .product-img {
            height: 150px;
        }
    }
</style>

<div style="text-align: center; margin-top: 25px; margin-bottom: 25px;">
    <h1 class="shop-logo">GLAMORA SHOP</h1>
</div>

<div style="max-width: 1200px; margin: 0 auto; padding: 0 20px;">
    <div class="shop-controls">
        <h2 style="color: #6c757d;">Products</h2>
        <form method="get" asp-action="Index">
            <input type="text" name="searchString" value="@Model.SearchString" placeholder="Search..." class="search-input" />
            <button type="submit" class="search-btn">Search</button>
        </form>
    </div>
    <div class="cart-row" style="text-align: right; margin-bottom: 20px;">
        <a asp-controller="Cart"
           asp-action="Index"
           class="btn-confirm-order"
           style="text-decoration: none; display: inline-block; color: white">
            🛒 Shopping Cart
        </a>
    </div>

    @foreach (var brandGroup in Model.GroupedProducts)
    {
        <div class="brand-divider">
            <span class="brand-title">@brandGroup.Key</span>
        </div>

        <div class="products-grid">
            @foreach (var product in brandGroup.Value)
            {
                <div class="product-card">
                    <img src="@(string.IsNullOrEmpty(product.ImageUrl) ? "/images/default.jpg" : product.ImageUrl)" alt="@product.Name" class="product-img">
    
                    <div class="card-content">
                        <h6 style="margin: 10px 0;">@product.Name</h6>
                        <p style="font-weight: bold; margin-bottom: 10px;">$@product.Price</p>
                        <p class="product-description">@product.Description</p>

                        <form asp-controller="Cart"
                              asp-action="AddToCart"
                              method="post">

                            <input type="hidden" name="productId" value="@product.Id" />

                            <button type="submit" class="buy-btn">
                                Add to Cart
                            </button>

                        </form>

                    </div>
                </div>
            }
        </div>
    }
  
</div>
