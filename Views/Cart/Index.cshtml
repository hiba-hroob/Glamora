@model List<Webproject.Models.CartItem>

@{
    ViewData["Title"] = "Shopping Cart";
}


<style>
    body {
        background-color: #fffafb;
        font-family: sans-serif;
    }

    .cart-container {
        width: 100%;
        max-width: 1000px;
        margin: 40px auto;
        padding: 0 20px;
    }

    .cart-title {
        color: #b83b5e;
        text-align: center;
        margin-bottom: 30px;
    }

    .cart-item {
        display: grid;
        grid-template-columns: 90px minmax(0, 1fr) auto;
        align-items: center;
        gap: 20px;
        background: white;
        border: 1px solid #f7d6e0;
        border-radius: 12px;
        padding: 15px;
        margin-bottom: 15px;
    }

    .cart-item img {
        width: 90px;
        height: 90px;
        object-fit: contain;
    }

    .cart-info {
        min-width: 0;
    }

    .cart-info h4 {
        margin: 0 0 5px;
        color: #333;
        font-size: 18px;
        line-height: 1.3;
    }

    .cart-info p {
        margin: 4px 0;
        color: #6c757d;
    }

    .cart-quantity {
        margin-top: 10px;
    }

    .cart-quantity-controls {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .quantity-form {
        margin: 0;
    }

    .quantity-btn {
        border: none;
        background: #f7d6e0;
        color: #b83b5e;
        font-weight: bold;
        border-radius: 50%;
        width: 30px;
        height: 30px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
    }

    .quantity-number {
        min-width: 25px;
        text-align: center;
        font-weight: bold;
        color: #b83b5e;
    }

    .item-actions {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 10px;
        min-width: 95px;
    }

    .item-total {
        font-size: 17px;
        color: #333;
        white-space: nowrap;
    }

    .remove-form {
        margin: 0;
    }

    .remove-btn {
        border: none;
        background: #d90429;
        color: white;
        padding: 6px 12px;
        border-radius: 15px;
        cursor: pointer;
        font-size: 12px;
    }

    .cart-total {
        text-align: right;
        margin-top: 25px;
        font-size: 20px;
        font-weight: bold;
        color: #333;
    }

    .cart-buttons {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        margin-top: 25px;
    }

    .confirm-form {
        margin: 0;
    }

    .cart-btn {
        background-color: #b83b5e;
        color: white;
        border: none;
        padding: 10px 25px;
        border-radius: 25px;
        text-decoration: none;
        cursor: pointer;
        display: inline-block;
        text-align: center;
    }

    .cart-btn:hover {
        opacity: 0.9;
        color: white;
    }

    .empty-cart {
        text-align: center;
        background: white;
        border: 1px solid #f7d6e0;
        border-radius: 12px;
        padding: 40px;
        color: #6c757d;
    }

    /* Tablet / iPad */
    @@media (max-width: 991px) {
        .cart-container {
            max-width: 900px;
            padding: 0 18px;
        }

        .cart-item {
            grid-template-columns: 80px minmax(0, 1fr) auto;
            gap: 15px;
            padding: 14px;
        }

        .cart-item img {
            width: 80px;
            height: 80px;
        }

        .cart-info h4 {
            font-size: 16px;
        }

        .cart-info p {
            font-size: 14px;
        }

        .item-actions {
            min-width: 85px;
        }
    }

    /* Mobile */
    @@media (max-width: 767px) {
        .cart-container {
            margin: 25px auto;
            padding: 0 14px;
        }

        .cart-title {
            font-size: 27px;
            margin-bottom: 22px;
        }

        .cart-item {
            grid-template-columns: 80px minmax(0, 1fr);
            gap: 12px;
            padding: 12px;
        }

        .cart-item img {
            width: 75px;
            height: 75px;
        }

        .cart-info h4 {
            font-size: 15px;
        }

        .cart-info p {
            font-size: 13px;
        }

        .cart-quantity {
            margin-top: 8px;
        }

        .item-actions {
            grid-column: 2;
            align-items: flex-start;
            min-width: 0;
            gap: 8px;
        }

        .item-total {
            font-size: 16px;
        }

        .cart-total {
            text-align: center;
            font-size: 19px;
            margin-top: 20px;
        }

        .cart-buttons {
            flex-direction: column;
            align-items: stretch;
            gap: 10px;
        }

        .cart-buttons .cart-btn,
        .confirm-form,
        .confirm-form .cart-btn {
            width: 100%;
        }

        .empty-cart {
            padding: 30px 18px;
        }

        .empty-cart .cart-btn {
            width: 100%;
            margin-top: 10px;
        }
    }

    /* Small phones */
    @@media (max-width: 480px) {
        .cart-title {
            font-size: 24px;
        }

        .cart-item {
            grid-template-columns: 1fr;
            text-align: center;
            padding: 16px 12px;
            gap: 10px;
        }

        .cart-item img {
            width: 100px;
            height: 100px;
            margin: 0 auto;
        }

        .cart-info h4 {
            font-size: 16px;
        }

        .cart-info p {
            font-size: 13px;
        }

        .cart-quantity-controls {
            justify-content: center;
        }

        .item-actions {
            grid-column: 1;
            align-items: center;
            width: 100%;
        }

        .item-total {
            font-size: 17px;
        }

        .remove-btn {
            padding: 7px 18px;
        }
    }
</style>


<div class="cart-container">

    <h2 class="cart-title">Shopping Cart</h2>

    @if (Model == null || Model.Count == 0)
    {
        <div class="empty-cart">
            <h4>Your cart is empty.</h4>

            <a asp-controller="Products"
               asp-action="Index"
               class="cart-btn">
                Continue Shopping
            </a>
        </div>
    }
    else
    {
        decimal grandTotal = 0;

        foreach (var item in Model)
        {
            grandTotal += item.Total;

            <div class="cart-item">

                <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "/images/default.jpg" : item.ImageUrl)"
                     alt="@item.ProductName" />

                <div class="cart-info">
                    <h4>@item.ProductName</h4>

                    <p>@item.Brand</p>

                    <p>Price: $@item.Price</p>

                    <div class="cart-quantity">
    <div class="cart-quantity-controls">

        <form asp-controller="Cart"
              asp-action="DecreaseQuantity"
              method="post"
              class="quantity-form">

            <input type="hidden"
                   name="productId"
                   value="@item.ProductId" />

            <button type="submit" class="quantity-btn">
                −
            </button>

        </form>

        <span class="quantity-number">
            @item.Quantity
        </span>

        <form asp-controller="Cart"
              asp-action="IncreaseQuantity"
              method="post"
              class="quantity-form">

            <input type="hidden"
                   name="productId"
                   value="@item.ProductId" />

            <button type="submit" class="quantity-btn">
                +
            </button>

        </form>

    </div>
</div>

<div class="item-actions">

    <strong class="item-total">$@item.Total</strong>

    <form asp-controller="Cart"
          asp-action="RemoveFromCart"
          method="post"
          class="remove-form">

        <input type="hidden"
               name="productId"
               value="@item.ProductId" />

        <button type="submit" class="remove-btn">
            Remove
        </button>

    </form>

</div>
</div>

      </div>
        }

        <div class="cart-total">
            Total: $@grandTotal
        </div>

        <div class="cart-buttons">

            <a asp-controller="Products"
               asp-action="Index"
               class="cart-btn">
                Continue Shopping
            </a>

            <form asp-controller="Orders"
                  asp-action="ConfirmOrder"
                  method="post"
                  class="confirm-form">

                <button type="submit" class="cart-btn">
                    Confirm Order
                </button>

            </form>

        </div>
    }

</div>
